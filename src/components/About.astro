---
import { logo } from '../assets/media';
import { siteConfig } from '../config/site';
import { siteContent } from '../content/site';
import Icon from './Icon.astro';

const { about } = siteContent;
---

<section id="nosotros" class="scroll-mt-24 bg-brand-sky py-20 sm:py-24">
  <div
    class="page-shell grid min-w-0 items-center gap-14 lg:grid-cols-2 lg:gap-16"
  >
    <div class="relative mx-auto w-full min-w-0 max-w-sm">
      <div
        class="absolute inset-0 translate-x-4 translate-y-4 rounded-3xl bg-[linear-gradient(135deg,#6b3fd4,#00cdb8)] opacity-15"
      >
      </div>
      <div class="relative rounded-3xl bg-white p-7 shadow-2xl">
        <video
          class="aspect-square w-full rounded-2xl bg-black object-cover"
          autoplay
          muted
          loop
          playsinline
          preload="metadata"
          poster={logo.src}
          aria-label={about.videoLabel}
          onloadedmetadata="if(matchMedia('(prefers-reduced-motion: reduce)').matches){this.onloadedmetadata=null;this.removeAttribute('autoplay');this.pause();this.currentTime=0;this.load()}"
        >
          <source src="/gatito.mp4" type="video/mp4" />
          {about.videoFallback}
        </video>
        <ul class="mt-5 flex flex-wrap gap-2" aria-label="Nuestros valores">
          {
            about.values.map((value) => (
              <li class="rounded-full bg-brand-blue px-3 py-1 text-xs font-semibold text-white">
                {value}
              </li>
            ))
          }
        </ul>
      </div>
      <p
        class="motion-art absolute right-1 top-1 z-10 rounded-xl bg-brand-blue px-4 py-3 text-white shadow-xl sm:-right-6 sm:-top-6"
      >
        <strong class="block text-2xl font-black">{about.candidates}</strong>
        <span class="text-xs">{about.candidatesLabel}</span>
      </p>
    </div>

    <div class="min-w-0">
      <p class="eyebrow">{about.eyebrow}</p>
      <h2
        class="mt-4 text-4xl font-black leading-tight text-brand-ink sm:text-5xl"
      >
        <span class="block">{about.titleStart}</span><span
          class="block bg-brand bg-clip-text text-transparent"
          >{about.titleAccent}</span
        ><span class="block">{about.titleEnd}</span>
      </h2>
      <p class="mt-6 max-w-2xl text-lg leading-7 text-brand-muted">
        {about.description}
      </p>
      <p
        class="mt-3 flex max-w-2xl items-start gap-2 leading-7 text-brand-muted"
      >
        <Icon
          name="map-pin"
          class="mt-1 size-4 shrink-0 text-brand-teal"
        /><span>{about.location}</span>
      </p>
      <div class="mt-8 grid min-w-0 gap-5 sm:grid-cols-2">
        {
          about.pillars.map(({ title, description }, index) => (
            <article
              class:list={[
                'surface-card min-w-0 border-t-4 p-5 transition hover:-translate-y-1 hover:shadow-xl',
                index ? 'border-t-brand-teal' : 'border-t-brand-violet',
              ]}
            >
              <div
                class:list={[
                  'mb-3 grid size-11 place-items-center rounded-xl text-white',
                  index
                    ? 'bg-[linear-gradient(135deg,#00cdb8,#5bbfe8)]'
                    : 'bg-[linear-gradient(135deg,#6b3fd4,#00cdb8)]',
                ]}
              >
                <Icon name={index ? 'eye' : 'target'} />
              </div>
              <h3 class="text-lg font-black text-brand-ink">{title}</h3>
              <p class="mt-3 text-sm leading-6 text-brand-muted">
                {description}
              </p>
            </article>
          ))
        }
      </div>
      <a
        class="mt-7 inline-flex items-center gap-2 rounded-full bg-brand-blue px-7 py-3.5 text-sm font-bold text-white shadow-[0_8px_25px_rgba(59,130,246,.35)] transition hover:-translate-y-1 hover:bg-blue-600"
        href={siteConfig.contactHref}
      >
        <Icon name="message-square" class="size-4" />
        {about.cta}
      </a>
    </div>
  </div>
</section>
