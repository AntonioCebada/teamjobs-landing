---
import { Image } from 'astro:assets';
import { logo } from '../assets/media';
import { siteConfig } from '../config/site';
import { siteContent } from '../content/site';

const { about } = siteContent;
---

<section id="nosotros" class="scroll-mt-24 bg-brand-sky py-20 sm:py-24">
  <div
    class="page-shell grid min-w-0 items-center gap-12 lg:grid-cols-[0.85fr_1.15fr]"
  >
    <div class="surface-card relative mx-auto w-full min-w-0 max-w-sm p-5">
      <div class="rounded-2xl bg-white/70 p-6">
        <Image
          src={logo}
          alt={siteContent.seo.imageAlt}
          width={logo.width}
          height={logo.height}
          loading="lazy"
        />
      </div>
      <p
        class="absolute -right-2 -top-8 rounded-xl bg-brand-blue px-4 py-3 text-white shadow-xl sm:right-[-1.25rem] sm:top-[-1.5rem]"
      >
        <strong class="block text-xl">{about.candidates}</strong>
        <span class="text-xs">{about.candidatesLabel}</span>
      </p>
      <ul class="mt-5 flex flex-wrap gap-2" aria-label="Nuestros valores">
        {
          about.values.map((value) => (
            <li class="rounded-full bg-brand-blue px-3 py-1 text-xs font-semibold text-white">
              {value}
            </li>
          ))
        }
      </ul>
    </div>

    <div class="min-w-0">
      <p class="eyebrow">{about.eyebrow}</p>
      <h2
        class="mt-5 text-3xl font-bold leading-tight text-brand-navy sm:text-5xl"
      >
        {about.titleStart}<span class="bg-brand bg-clip-text text-transparent"
          >{about.titleAccent}</span
        >{about.titleEnd}
      </h2>
      <p class="mt-6 max-w-2xl leading-7 text-brand-muted">
        {about.description}
      </p>
      <p class="mt-4 max-w-2xl leading-7 text-brand-muted">{about.location}</p>
      <div class="mt-8 grid min-w-0 gap-4 sm:grid-cols-2">
        {
          about.pillars.map(({ title, description }, index) => (
            <article
              class:list={[
                'surface-card min-w-0 border-t-4 p-5',
                index ? 'border-t-brand-teal' : 'border-t-brand-violet',
              ]}
            >
              <h3 class="text-lg font-bold text-brand-navy">{title}</h3>
              <p class="mt-3 text-sm leading-6 text-brand-muted">
                {description}
              </p>
            </article>
          ))
        }
      </div>
      <a
        class="mt-7 inline-flex rounded-full bg-brand-blue px-6 py-3 font-semibold text-white shadow-lg hover:bg-brand-violet"
        href={siteConfig.contactHref}
      >
        {about.cta}
      </a>
    </div>
  </div>
</section>
