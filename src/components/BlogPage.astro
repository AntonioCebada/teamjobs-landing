---
import { siteContent } from '../content/site';

const { blog } = siteContent;
---

<section class="bg-white py-10 sm:py-14 lg:py-16">
  <div class="blog-page-canvas min-w-0" data-blog-canvas>
    <header class="blog-intro" data-blog-intro>
      <p class="eyebrow">{blog.eyebrow}</p>
      <h1 class="blog-intro-title font-bold text-brand-navy" data-blog-title>
        {blog.title}
      </h1>
      <p class="blog-intro-subtitle text-brand-muted" data-blog-subtitle>
        {blog.description}
      </p>
    </header>

    <div
      class="mt-8 flex flex-wrap gap-2"
      role="group"
      aria-label={blog.categoriesLabel}
      data-static-categories
    >
      {
        blog.categories.map((category, index) => (
          <span
            class:list={[
              'rounded-full border px-4 py-2 text-sm font-semibold',
              index === 0
                ? 'border-brand-blue bg-brand-blue text-white'
                : 'border-brand-ink/10 bg-brand-surface text-brand-ink',
            ]}
            data-static-category
          >
            {category}
          </span>
        ))
      }
    </div>
    <p class="sr-only">{blog.categoriesNote}</p>

    <div class="mt-10 grid min-w-0 gap-8 xl:grid-cols-[minmax(0,1fr)_18rem]">
      <section class="min-w-0" aria-labelledby="blog-feed-title">
        <h2 id="blog-feed-title" class="sr-only">Publicaciones de Contenido</h2>
        <div class="blog-masonry min-w-0" data-blog-masonry>
          {
            blog.posts.map((post) => (
              <article
                class="blog-card overflow-hidden rounded-[1.25rem] border border-brand-ink/10 bg-white shadow-[0_0.75rem_2rem_rgba(45,50,112,0.08)]"
                data-layout={post.layout}
                data-tone={post.tone}
                data-blog-card
                aria-label={post.title}
              >
                <div
                  class="blog-placeholder"
                  data-placeholder
                  role="img"
                  aria-label={post.placeholder}
                />
                <div class="blog-card-overlay" data-blog-overlay>
                  <span data-blog-publisher>{post.author}</span>
                  <span data-blog-reading-time>{post.readingTime}</span>
                </div>
              </article>
            ))
          }
        </div>
      </section>

      <aside
        class="blog-sidebar h-fit rounded-[1.25rem] border border-brand-ink/10 bg-brand-surface p-5 shadow-[0_0.75rem_2rem_rgba(45,50,112,0.06)] xl:sticky xl:top-24"
        aria-labelledby="blog-sidebar-title"
      >
        <h2 id="blog-sidebar-title" class="text-lg font-bold text-brand-navy">
          {blog.sidebar.title}
        </h2>
        <p class="mt-2 text-sm leading-6 text-brand-muted">
          {blog.sidebar.description}
        </p>
        <ul class="mt-5 divide-y divide-brand-ink/10">
          {
            blog.sidebar.items.map((item) => (
              <li class="flex gap-3 py-4 first:pt-0 last:pb-0">
                <span
                  class="grid size-10 shrink-0 place-items-center rounded-xl border border-brand-blue/20 bg-white text-lg font-bold text-brand-blue"
                  aria-hidden="true"
                >
                  {item.company}
                </span>
                <span class="min-w-0">
                  <strong class="block text-sm font-bold text-brand-navy">
                    {item.title}
                  </strong>
                  <span class="mt-1 block text-xs leading-5 text-brand-muted">
                    {item.meta}
                  </span>
                </span>
              </li>
            ))
          }
        </ul>
        <p
          class="mt-5 border-t border-brand-ink/10 pt-4 text-xs leading-5 text-brand-muted"
        >
          {blog.sidebar.note}
        </p>
      </aside>
    </div>
  </div>
</section>

<style>
  .blog-page-canvas {
    width: 100%;
    max-width: none;
    margin-inline: auto;
    padding-inline: clamp(1rem, 3vw, 4rem);
  }

  .blog-intro {
    width: 100%;
    max-width: none;
    min-width: 0;
  }

  .blog-intro-title {
    width: 100%;
    max-width: none;
    min-width: 0;
    margin-top: clamp(1rem, 1.25vw, 1.5rem);
    overflow-wrap: break-word;
    font-size: clamp(2.25rem, calc(2rem + 1.1vw), 4rem);
    line-height: 1.05;
    letter-spacing: -0.04em;
    text-wrap: balance;
  }

  .blog-intro-subtitle {
    width: 100%;
    max-width: none;
    min-width: 0;
    margin-top: clamp(0.75rem, 0.8vw, 1.25rem);
    font-size: clamp(1rem, calc(0.9rem + 0.3vw), 1.25rem);
    line-height: clamp(1.5rem, calc(1.4rem + 0.3vw), 2rem);
  }

  .blog-masonry {
    column-count: 1;
    column-gap: clamp(0.75rem, 1.25vw, 1.5rem);
  }

  .blog-card {
    position: relative;
    display: inline-block;
    width: 100%;
    margin: 0 0 1rem;
    break-inside: avoid;
    isolation: isolate;
    min-height: 13rem;
    vertical-align: top;
  }

  .blog-placeholder {
    position: absolute;
    z-index: 0;
    inset: 0;
    border-radius: inherit;
    border: 1px solid rgb(45 50 112 / 0.12);
    background: var(--placeholder-bg);
    pointer-events: none;
  }

  .blog-card-overlay {
    position: absolute;
    z-index: 1;
    inset-inline: 0;
    bottom: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 2.75rem 1rem 1rem;
    background: linear-gradient(
      180deg,
      rgb(13 17 69 / 0%),
      rgb(13 17 69 / 0.18) 24%,
      rgb(13 17 69 / 0.94) 100%
    );
    color: #ffffff;
    font-size: 0.75rem;
    font-weight: 700;
    line-height: 1.4;
    text-shadow: 0 1px 0 rgb(13 17 69 / 0.35);
  }

  .blog-card-overlay span:last-child {
    flex-shrink: 0;
    font-weight: 600;
  }

  .blog-card[data-layout='tall'] {
    min-height: 25rem;
  }

  .blog-card[data-layout='feature'] {
    min-height: 22rem;
  }

  .blog-card[data-layout='medium'] {
    min-height: 18rem;
  }

  .blog-card[data-layout='compact'],
  .blog-card[data-layout='quote'] {
    min-height: 13rem;
  }

  .blog-card[data-tone='navy'] {
    --placeholder-bg: #123b75;
    --placeholder-ink: #ffffff;
  }

  .blog-card[data-tone='sky'] {
    --placeholder-bg: #f1f7ff;
    --placeholder-ink: #2d3270;
  }

  .blog-card[data-tone='blue'] {
    --placeholder-bg: #e6f0ff;
    --placeholder-ink: #1457ca;
  }

  .blog-card[data-tone='violet'] {
    --placeholder-bg: #f3efff;
    --placeholder-ink: #6b3fd4;
  }

  .blog-card[data-tone='teal'] {
    --placeholder-bg: #e6fbf8;
    --placeholder-ink: #007f74;
  }

  .blog-card[data-tone='white'] {
    --placeholder-bg: #ffffff;
    --placeholder-ink: #2d3270;
  }

  .blog-card[data-tone='blue-soft'] {
    --placeholder-bg: #edf5ff;
    --placeholder-ink: #2b65c4;
  }

  .blog-card[data-tone='violet-soft'] {
    --placeholder-bg: #f2f0ff;
    --placeholder-ink: #5540ad;
  }

  .blog-card[data-tone='lilac'] {
    --placeholder-bg: #f4efff;
    --placeholder-ink: #6640bf;
  }

  @media (min-width: 40rem) {
    .blog-masonry {
      column-count: 2;
    }

    .blog-card {
      margin-bottom: 1.25rem;
    }
  }

  @media (min-width: 64rem) {
    .blog-masonry {
      column-count: 3;
    }
  }

  @media (min-width: 90rem) {
    .blog-masonry {
      column-count: 4;
    }
  }

  @media (min-width: 120rem) {
    .blog-masonry {
      column-count: 5;
    }
  }

  @media (min-width: 150rem) {
    .blog-masonry {
      column-count: 6;
    }
  }
</style>
