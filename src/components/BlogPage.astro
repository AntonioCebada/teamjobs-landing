---
import BlogApp from '../islands/BlogApp';
import { siteContent } from '../content/site';

const { blog } = siteContent;
---

<section class="bg-white py-10 sm:py-14 lg:py-16">
  <div class="blog-page-canvas min-w-0" data-blog-canvas>
    <header class="blog-intro" data-blog-intro>
      <p class="eyebrow">{blog.eyebrow}</p>
      <h1 class="blog-intro-title font-bold text-brand-navy" data-blog-title>
        {blog.title}
      </h1>
      <p class="blog-intro-subtitle text-brand-muted" data-blog-subtitle>
        {blog.description}
      </p>
    </header>

    <div
      class="mt-8 flex flex-wrap gap-2"
      role="group"
      aria-label={blog.categoriesLabel}
      data-static-categories
    >
      {
        blog.categories.map((category, index) => (
          <span
            class:list={[
              'rounded-full border px-4 py-2 text-sm font-semibold',
              index === 0
                ? 'border-brand-blue bg-brand-blue text-white'
                : 'border-brand-ink/10 bg-brand-surface text-brand-ink',
            ]}
            data-static-category
          >
            {category}
          </span>
        ))
      }
    </div>
    <p class="sr-only">{blog.categoriesNote}</p>

    <div class="mt-10 grid min-w-0 gap-8 xl:grid-cols-[minmax(0,1fr)_18rem]">
      <section class="min-w-0" aria-labelledby="blog-feed-title">
        <h2 id="blog-feed-title" class="sr-only">Publicaciones de Contenido</h2>
        <BlogApp client:load />
      </section>

      <aside
        class="blog-sidebar h-fit rounded-[1.25rem] border border-brand-ink/10 bg-brand-surface p-5 shadow-[0_0.75rem_2rem_rgba(45,50,112,0.06)] xl:sticky xl:top-24"
        aria-labelledby="blog-sidebar-title"
      >
        <h2 id="blog-sidebar-title" class="text-lg font-bold text-brand-navy">
          {blog.sidebar.title}
        </h2>
        <p class="mt-2 text-sm leading-6 text-brand-muted">
          {blog.sidebar.description}
        </p>
        <ul class="mt-5 divide-y divide-brand-ink/10">
          {
            blog.sidebar.items.map((item) => (
              <li class="flex gap-3 py-4 first:pt-0 last:pb-0">
                <span
                  class="grid size-10 shrink-0 place-items-center rounded-xl border border-brand-blue/20 bg-white text-lg font-bold text-brand-blue"
                  aria-hidden="true"
                >
                  {item.company}
                </span>
                <span class="min-w-0">
                  <strong class="block text-sm font-bold text-brand-navy">
                    {item.title}
                  </strong>
                  <span class="mt-1 block text-xs leading-5 text-brand-muted">
                    {item.meta}
                  </span>
                </span>
              </li>
            ))
          }
        </ul>
        <p
          class="mt-5 border-t border-brand-ink/10 pt-4 text-xs leading-5 text-brand-muted"
        >
          {blog.sidebar.note}
        </p>
      </aside>
    </div>
  </div>
</section>

<style>
  .blog-page-canvas {
    width: 100%;
    max-width: none;
    margin-inline: auto;
    padding-inline: clamp(1rem, 3vw, 4rem);
  }

  .blog-intro {
    width: 100%;
    max-width: none;
    min-width: 0;
  }

  .blog-intro-title {
    width: 100%;
    max-width: none;
    min-width: 0;
    margin-top: clamp(1rem, 1.25vw, 1.5rem);
    overflow-wrap: break-word;
    font-size: clamp(2.25rem, calc(2rem + 1.1vw), 4rem);
    line-height: 1.05;
    letter-spacing: -0.04em;
    text-wrap: balance;
  }

  .blog-intro-subtitle {
    width: 100%;
    max-width: none;
    min-width: 0;
    margin-top: clamp(0.75rem, 0.8vw, 1.25rem);
    font-size: clamp(1rem, calc(0.9rem + 0.3vw), 1.25rem);
    line-height: clamp(1.5rem, calc(1.4rem + 0.3vw), 2rem);
  }
</style>
