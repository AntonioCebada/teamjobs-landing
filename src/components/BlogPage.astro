---
import { siteContent } from '../content/site';

const { blog } = siteContent;
---

<section class="bg-white py-10 sm:py-14 lg:py-16">
  <div class="page-shell min-w-0">
    <header class="max-w-3xl">
      <p class="eyebrow">{blog.eyebrow}</p>
      <h1
        class="mt-5 text-4xl font-bold leading-tight text-brand-navy sm:text-5xl lg:text-6xl"
      >
        {blog.titleStart}<span class="bg-brand bg-clip-text text-transparent"
          >{blog.titleAccent}</span
        >
      </h1>
      <p class="mt-5 max-w-2xl text-base leading-7 text-brand-muted sm:text-lg">
        {blog.description}
      </p>
    </header>

    <div
      class="mt-8 flex flex-wrap gap-2"
      role="group"
      aria-label={blog.categoriesLabel}
      data-static-categories
    >
      {
        blog.categories.map((category, index) => (
          <span
            class:list={[
              'rounded-full border px-4 py-2 text-sm font-semibold',
              index === 0
                ? 'border-brand-blue bg-brand-blue text-white'
                : 'border-brand-ink/10 bg-brand-surface text-brand-ink',
            ]}
            data-static-category
          >
            {category}
          </span>
        ))
      }
    </div>
    <p class="sr-only">{blog.categoriesNote}</p>

    <div class="mt-10 grid min-w-0 gap-8 xl:grid-cols-[minmax(0,1fr)_18rem]">
      <section class="min-w-0" aria-labelledby="blog-feed-title">
        <h2 id="blog-feed-title" class="sr-only">Publicaciones de Contenido</h2>
        <div class="blog-masonry min-w-0" data-blog-masonry>
          {
            blog.posts.map((post) => (
              <article
                class="blog-card overflow-hidden rounded-[1.25rem] border border-brand-ink/10 bg-white shadow-[0_0.75rem_2rem_rgba(45,50,112,0.08)]"
                data-layout={post.layout}
                data-tone={post.tone}
                aria-labelledby={`blog-post-${post.id}`}
              >
                <div
                  class="blog-placeholder"
                  data-placeholder
                  role="img"
                  aria-label={post.placeholder}
                >
                  <span>{post.placeholder}</span>
                </div>
                <div class="p-5 sm:p-6">
                  <div class="flex items-center justify-between gap-3">
                    <span class="rounded-full bg-brand-sky px-3 py-1 text-[0.7rem] font-bold uppercase tracking-[0.08em] text-brand-violet">
                      {post.category}
                    </span>
                    <time
                      class="shrink-0 text-xs font-semibold text-brand-muted"
                      datetime={post.dateTime}
                    >
                      {post.date}
                    </time>
                  </div>
                  <h3
                    id={`blog-post-${post.id}`}
                    class="mt-4 text-xl font-bold leading-tight text-brand-navy"
                  >
                    {post.title}
                  </h3>
                  <p class="mt-3 text-sm leading-6 text-brand-muted">
                    {post.description}
                  </p>
                  <div class="mt-5 flex flex-wrap items-center justify-between gap-2 border-t border-brand-ink/10 pt-4 text-xs font-semibold text-brand-muted">
                    <span>{post.author}</span>
                    <span>{post.readingTime}</span>
                  </div>
                </div>
              </article>
            ))
          }
        </div>
      </section>

      <aside
        class="blog-sidebar h-fit rounded-[1.25rem] border border-brand-ink/10 bg-brand-surface p-5 shadow-[0_0.75rem_2rem_rgba(45,50,112,0.06)] xl:sticky xl:top-24"
        aria-labelledby="blog-sidebar-title"
      >
        <h2 id="blog-sidebar-title" class="text-lg font-bold text-brand-navy">
          {blog.sidebar.title}
        </h2>
        <p class="mt-2 text-sm leading-6 text-brand-muted">
          {blog.sidebar.description}
        </p>
        <ul class="mt-5 divide-y divide-brand-ink/10">
          {
            blog.sidebar.items.map((item) => (
              <li class="flex gap-3 py-4 first:pt-0 last:pb-0">
                <span
                  class="grid size-10 shrink-0 place-items-center rounded-xl border border-brand-blue/20 bg-white text-lg font-bold text-brand-blue"
                  aria-hidden="true"
                >
                  {item.company}
                </span>
                <span class="min-w-0">
                  <strong class="block text-sm font-bold text-brand-navy">
                    {item.title}
                  </strong>
                  <span class="mt-1 block text-xs leading-5 text-brand-muted">
                    {item.meta}
                  </span>
                </span>
              </li>
            ))
          }
        </ul>
        <p
          class="mt-5 border-t border-brand-ink/10 pt-4 text-xs leading-5 text-brand-muted"
        >
          {blog.sidebar.note}
        </p>
      </aside>
    </div>
  </div>
</section>

<style>
  .blog-masonry {
    column-count: 1;
    column-gap: 1rem;
  }

  .blog-card {
    display: inline-block;
    width: 100%;
    margin: 0 0 1rem;
    break-inside: avoid;
    vertical-align: top;
  }

  .blog-placeholder {
    display: grid;
    min-height: 9rem;
    place-items: center;
    border-bottom: 1px solid rgb(45 50 112 / 0.12);
    padding: 1.25rem;
    color: var(--placeholder-ink);
    background: var(--placeholder-bg);
    text-align: center;
  }

  .blog-placeholder span {
    max-width: 12rem;
    border: 1px dashed currentColor;
    border-radius: 0.75rem;
    padding: 0.75rem 1rem;
    font-size: 0.75rem;
    font-weight: 600;
    line-height: 1.4;
    opacity: 0.78;
  }

  .blog-card[data-layout='tall'] .blog-placeholder {
    min-height: 17rem;
  }

  .blog-card[data-layout='feature'] .blog-placeholder {
    min-height: 15rem;
  }

  .blog-card[data-layout='medium'] .blog-placeholder {
    min-height: 11rem;
  }

  .blog-card[data-layout='compact'] .blog-placeholder,
  .blog-card[data-layout='quote'] .blog-placeholder {
    min-height: 7rem;
  }

  .blog-card[data-tone='navy'] {
    --placeholder-bg: #123b75;
    --placeholder-ink: #ffffff;
  }

  .blog-card[data-tone='sky'] {
    --placeholder-bg: #f1f7ff;
    --placeholder-ink: #2d3270;
  }

  .blog-card[data-tone='blue'] {
    --placeholder-bg: #e6f0ff;
    --placeholder-ink: #1457ca;
  }

  .blog-card[data-tone='violet'] {
    --placeholder-bg: #f3efff;
    --placeholder-ink: #6b3fd4;
  }

  .blog-card[data-tone='teal'] {
    --placeholder-bg: #e6fbf8;
    --placeholder-ink: #007f74;
  }

  .blog-card[data-tone='white'] {
    --placeholder-bg: #ffffff;
    --placeholder-ink: #2d3270;
  }

  .blog-card[data-tone='blue-soft'] {
    --placeholder-bg: #edf5ff;
    --placeholder-ink: #2b65c4;
  }

  .blog-card[data-tone='violet-soft'] {
    --placeholder-bg: #f2f0ff;
    --placeholder-ink: #5540ad;
  }

  .blog-card[data-tone='lilac'] {
    --placeholder-bg: #f4efff;
    --placeholder-ink: #6640bf;
  }

  @media (min-width: 40rem) {
    .blog-masonry {
      column-count: 2;
      column-gap: 1.25rem;
    }

    .blog-card {
      margin-bottom: 1.25rem;
    }
  }

  @media (min-width: 64rem) {
    .blog-masonry {
      column-count: 3;
    }
  }
</style>
