---
import { siteConfig } from '../config/site';
import { siteContent } from '../content/site';
import ContactForm from '../islands/ContactForm';

const { contact } = siteContent;
const whatsappUrl = `https://wa.me/${siteConfig.whatsappNumber.replace(/\D/g, '')}`;
---

<section
  id="contacto"
  class="scroll-mt-24 bg-white py-20 sm:py-24"
  aria-labelledby="contact-title"
>
  <div class="page-shell min-w-0">
    <header class="mx-auto max-w-3xl text-center">
      <p class="eyebrow mx-auto">{contact.eyebrow}</p>
      <h2
        id="contact-title"
        class="mt-5 text-3xl font-bold leading-tight text-brand-navy sm:text-5xl"
      >
        {contact.titleLead}<br /><span
          class="bg-brand bg-clip-text text-transparent"
          >{contact.titleAccent}</span
        >
      </h2>
      <p class="mx-auto mt-5 max-w-2xl leading-7 text-brand-muted">
        {contact.description}
      </p>
      <address
        class="mt-7 not-italic text-sm leading-7 text-brand-muted"
        aria-label="Datos de contacto de TeamJobs"
      >
        <span class="block">{contact.details.address}</span>
        <span class="block">
          <a
            class="underline hover:text-brand-violet"
            href={`mailto:${contact.details.email}`}
          >
            {contact.details.email}
          </a>
          <span aria-hidden="true"> · </span>
          <a
            class="underline hover:text-brand-violet"
            href={`tel:${siteConfig.whatsappNumber}`}
          >
            {contact.details.phone}
          </a>
          <span aria-hidden="true"> · </span>
          <a
            class="underline hover:text-brand-violet"
            href={whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            WhatsApp {contact.details.whatsapp}
          </a>
        </span>
        <span class="block">{contact.details.hours}</span>
      </address>
    </header>

    <div
      class="mx-auto mt-12 max-w-3xl rounded-3xl border border-gray-100 bg-white p-6 shadow-2xl sm:p-8"
    >
      <ContactForm client:visible />
    </div>
  </div>
</section>
