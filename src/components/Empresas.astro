---
import { siteConfig } from '../config/site';
import { siteContent } from '../content/site';

const { companies } = siteContent;
const accents = [
  'border-t-brand-violet',
  'border-t-brand-teal',
  'border-t-brand-blue',
  'border-t-brand-navy',
];
---

<section id="empresas" class="scroll-mt-24 bg-brand-sky py-20 sm:py-24">
  <div class="page-shell min-w-0">
    <header class="mx-auto max-w-3xl text-center">
      <p class="eyebrow mx-auto">{companies.eyebrow}</p>
      <h2
        class="mt-5 text-3xl font-bold leading-tight text-brand-navy sm:text-5xl"
      >
        {companies.titleStart}<span
          class="bg-brand bg-clip-text text-transparent"
          >{companies.titleAccent}</span
        >
      </h2>
      <p class="mx-auto mt-5 max-w-2xl leading-7 text-brand-muted">
        {companies.description}
      </p>
    </header>

    <ol class="mt-12 grid min-w-0 gap-5 lg:grid-cols-4">
      {
        companies.steps.map(({ title, description, iconLabel }, index) => (
          <li
            class:list={[
              'surface-card relative min-w-0 border-t-4 px-6 pb-7 pt-12 text-center',
              accents[index],
            ]}
          >
            <span
              aria-hidden="true"
              class="absolute left-1/2 top-0 grid size-16 -translate-x-1/2 -translate-y-1/2 place-items-center rounded-full bg-brand-blue text-2xl font-bold text-white shadow-lg"
            >
              {index + 1}
            </span>
            <span
              class="mx-auto grid w-fit min-w-14 place-items-center rounded-lg bg-white/70 px-2 py-2 text-[0.625rem] font-semibold text-brand-muted"
              role="img"
              aria-label={iconLabel}
            >
              Icono
            </span>
            <h3 class="mt-4 text-lg font-bold text-brand-navy">{title}</h3>
            <p class="mt-3 text-sm leading-6 text-brand-muted">{description}</p>
          </li>
        ))
      }
    </ol>

    <div class="mt-10 text-center">
      <a
        class="inline-flex rounded-full bg-brand-blue px-6 py-3 font-semibold text-white shadow-lg hover:bg-brand-violet"
        href={siteConfig.contactHref}
      >
        {companies.cta}
      </a>
    </div>

    <div class="mt-16 min-w-0">
      <h3
        class="text-center text-xs font-semibold uppercase tracking-[0.2em] text-brand-muted"
      >
        {companies.trustHeading}
      </h3>
      <div
        class="company-carousel mt-6 overflow-hidden py-2"
        role="region"
        aria-label={companies.carouselLabel}
        tabindex="0"
      >
        <div class="company-track flex w-max gap-4">
          {
            companies.logoPlaceholders.map((label) => (
              <span class="company-logo">{label}</span>
            ))
          }
          <div class="contents" aria-hidden="true">
            {
              companies.logoPlaceholders.map((label) => (
                <span class="company-logo">{label}</span>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .company-track {
    animation: company-marquee 24s linear infinite;
  }

  .company-carousel:hover .company-track,
  .company-carousel:focus-within .company-track {
    animation-play-state: paused;
  }

  .company-logo {
    display: grid;
    min-width: 12rem;
    place-items: center;
    border: 1px solid
      color-mix(in srgb, var(--color-brand-ink) 12%, transparent);
    border-radius: var(--radius-pill);
    background: var(--color-brand-surface);
    padding: 0.8rem 1.25rem;
    color: var(--color-brand-muted);
    font-size: 0.75rem;
    font-weight: 600;
    box-shadow: 0 0.35rem 1rem
      color-mix(in srgb, var(--color-brand-ink) 8%, transparent);
  }

  @keyframes company-marquee {
    to {
      transform: translateX(calc(-50% - 0.5rem));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .company-carousel {
      overflow: visible;
    }

    .company-track {
      width: 100%;
      flex-wrap: wrap;
      justify-content: center;
      animation: none;
    }

    .company-track > [aria-hidden='true'] {
      display: none;
    }
  }
</style>
