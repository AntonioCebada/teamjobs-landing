---
import { Image } from 'astro:assets';
import { logo } from '../assets/media';
import { siteConfig } from '../config/site';
import { siteContent } from '../content/site';
import Icon from './Icon.astro';

const { hero } = siteContent;
---

<section
  id="inicio"
  class="relative overflow-hidden bg-[linear-gradient(145deg,#0d1145_0%,#2d3270_45%,#1a4a7a_100%)] pb-12 pt-6 text-white"
>
  <div
    class="pointer-events-none absolute -left-24 -top-24 size-96 rounded-full bg-brand-violet/20 blur-3xl"
  >
  </div>
  <div
    class="pointer-events-none absolute -right-20 top-1/3 size-80 rounded-full bg-brand-teal/15 blur-3xl"
  >
  </div>
  <div
    class="page-shell grid min-h-[38rem] min-w-0 items-center gap-12 py-14 lg:grid-cols-2 lg:py-20"
  >
    <div class="relative z-10">
      <p
        class="w-fit rounded-full border border-white/20 bg-white/10 px-4 py-2 text-xs font-semibold backdrop-blur-sm"
      >
        {hero.eyebrow}
      </p>
      <h1
        class="mt-7 max-w-xl text-4xl font-black leading-[1.12] tracking-tight sm:text-5xl xl:text-6xl"
      >
        <span class="block">{hero.titleStart}</span>
        <span class="block text-brand-blue"
          >{hero.titleAccent}<span class="text-white">
            {hero.titleEnd}</span
          ></span
        >
        {hero.titleTail.map((line) => <span class="block">{line}</span>)}
      </h1>
      <p class="mt-6 max-w-lg text-base leading-7 text-white/75 sm:text-lg">
        {hero.description}
      </p>
      <div class="mt-8 flex flex-wrap gap-4">
        <a
          class="inline-flex items-center gap-2 rounded-full bg-brand-blue px-7 py-3.5 text-sm font-bold shadow-[0_8px_25px_rgba(59,130,246,.45)] transition hover:-translate-y-1 hover:bg-blue-600"
          href={siteConfig.contactHref}
        >
          <Icon name="search" class="size-4" />
          {hero.primaryCta}
        </a>
        <a
          class="inline-flex items-center gap-2 rounded-full border-2 border-white/50 px-7 py-3.5 text-sm font-bold transition hover:-translate-y-1 hover:bg-white/15"
          href="#servicios"
        >
          <Icon name="star" class="size-4" />
          {hero.secondaryCta}
        </a>
      </div>
    </div>

    <div
      class="relative mx-auto grid aspect-square w-full max-w-md min-w-0 place-items-center"
    >
      <div
        class="motion-art absolute size-[88%] rounded-full border-2 border-dashed border-brand-teal/30"
      >
      </div>
      <div
        class="absolute size-[70%] rounded-full border-4 border-white/15 bg-brand-blue/10 shadow-[0_0_70px_rgba(91,191,232,.2)]"
      >
      </div>
      <div
        class="relative z-10 size-[58%] overflow-hidden rounded-full border-4 border-white/20 bg-[#263a76] shadow-2xl"
      >
        <Image
          src={logo}
          alt={siteContent.seo.imageAlt}
          width={logo.width}
          height={logo.height}
          priority
          class="size-full object-cover object-[center_55%]"
        />
      </div>
      <span
        class="absolute right-1 top-5 z-20 rounded-xl bg-white px-3 py-2 text-xs font-bold text-brand-ink shadow-xl sm:right-0 sm:text-sm"
      >
        <Icon name="target" class="mr-1 inline size-4 text-brand-blue" />{
          hero.stats[0]
        }
      </span>
      <span
        class="absolute bottom-5 left-1 z-20 rounded-xl bg-white px-3 py-2 text-xs font-bold text-brand-ink shadow-xl sm:left-0 sm:text-sm"
      >
        <Icon name="star" class="mr-1 inline size-4 text-amber-500" />{
          hero.stats[1]
        }
      </span>
      <span
        class="motion-art absolute left-1 top-1/4 grid size-11 place-items-center rounded-xl bg-brand-blue shadow-lg"
        aria-hidden="true"><Icon name="users" /></span
      >
      <span
        class="motion-art absolute bottom-1/4 right-1 grid size-11 place-items-center rounded-xl bg-brand-teal shadow-lg"
        aria-hidden="true"><Icon name="award" /></span
      >
    </div>
  </div>
  <svg
    aria-hidden="true"
    viewBox="0 0 1440 80"
    preserveAspectRatio="none"
    class="absolute bottom-0 h-12 w-full"
    ><path d="M0 40C360 80 1080 0 1440 40V80H0Z" fill="#ebf7fd"></path></svg
  >
</section>
