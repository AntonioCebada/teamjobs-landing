  whatsapp: 'simple-icons:whatsapp',
  'linkedin-in': 'simple-icons:linkedin',
  'facebook-f': 'simple-icons:facebook',
  instagram: 'simple-icons:instagram',
  'x-twitter': 'simple-icons:x',
  'paper-plane': 'lucide:send',
};

const filledIcons = new Set<keyof typeof icons>([
  'whatsapp',
  'linkedin-in',
  'facebook-f',
  'instagram',
  'x-twitter',
]);

interface Props {
  name: keyof typeof icons;
  class?: string;
}
const { name, class: className = 'size-5' } = Astro.props;
const iconSource = iconSources[name] ?? `lucide:${name}`;
const isFilled = filledIcons.has(name);
---

<svg
  aria-hidden="true"
  data-icon={iconSource}
  viewBox="0 0 24 24"
  class={className}
  fill={isFilled ? 'currentColor' : 'none'}
  stroke={isFilled ? 'none' : 'currentColor'}
  stroke-linecap="round"
  stroke-linejoin="round"
  stroke-width="2"><g set:html={icons[name]} /></svg
>
