---
import { Image } from 'astro:assets';
import { logo, mexicoFlag, usaFlag } from '../assets/media';
import { siteConfig } from '../config/site';
import { siteContent } from '../content/site';
import MobileNav from '../islands/MobileNav';
import SearchPlaceholder from './SearchPlaceholder.astro';

const { navigation } = siteContent;
const isHome = Astro.url.pathname === '/';
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const links = siteConfig.navigation.map(({ key, href, disabled }) => ({
  href,
  key,
  label: navigation.links[key],
  disabled: disabled ?? false,
  active: !disabled && href === currentPath,
}));
const brandHref = isHome ? '#inicio' : '/';
---

<nav
  aria-label={navigation.label}
  data-site-navigation
  class="border-b border-white/10 bg-brand-navy/95 text-white shadow-[0_4px_30px_rgba(13,17,69,0.35)] backdrop-blur-xl"
>
  <div
    class="mx-auto flex h-[72px] max-w-7xl items-center justify-between gap-4 px-4 md:px-8 lg:px-12"
  >
    <a
      href={brandHref}
      class="group flex items-center gap-3"
      aria-label="TeamJobs, inicio"
    >
      <span
        class="h-11 w-11 overflow-hidden rounded-full border-2 border-brand-blue/60 shadow-lg transition group-hover:border-brand-blue"
      >
        <Image
          src={logo}
          alt=""
          width={44}
          height={44}
          class="h-full w-full object-cover"
        />
      </span>
      <span class="text-xl font-black tracking-tight text-white"
        >Team<span class="text-brand-blue">Jobs</span></span
      >
    </a>
    <SearchPlaceholder class="hidden max-w-xl flex-1 md:flex" />
    <div class="hidden flex-1 items-center justify-center gap-7 lg:flex">
      {
        links.map(({ href, key, label, disabled, active }) => (
          <div>
            {disabled ? (
              <span
                data-nav-key={key}
                data-nav-disabled
                role="link"
                aria-disabled="true"
                tabindex="-1"
                title={navigation.disabled}
                class="cursor-not-allowed border-b-2 border-transparent pb-1 text-sm font-semibold text-white/45"
              >
                {label}
                <span class="sr-only"> ({navigation.disabled})</span>
              </span>
            ) : (
              <a
                data-nav-key={key}
                aria-current={active ? 'page' : undefined}
                class:list={[
                  'border-b-2 pb-1 text-sm font-semibold transition',
                  active
                    ? 'border-brand-blue text-brand-blue'
                    : 'border-transparent text-white/90 hover:border-brand-blue hover:text-white',
                ]}
                href={href}
              >
                {label}
              </a>
            )}
          </div>
        ))
      }
    </div>
    <div class="hidden items-center gap-3 lg:flex">
      <span
        role="img"
        aria-label={`Idioma actual: ${navigation.language}`}
        class="flex items-center gap-1 rounded-full border border-white/20 bg-white/10 p-1"
      >
        <span class="rounded-full bg-brand-blue p-1">
          <Image
            src={mexicoFlag}
            alt=""
            width={20}
            height={20}
            class="size-5 rounded-full object-cover"
          />
        </span>
        <span class="rounded-full p-1">
          <Image
            src={usaFlag}
            alt=""
            width={20}
            height={20}
            class="size-5 rounded-full object-cover"
          />
        </span>
      </span>
    </div>
    <MobileNav
      client:load
      links={links}
      labels={navigation}
      flags={{ mexico: mexicoFlag.src, usa: usaFlag.src }}
    />
  </div>
  <div class="px-4 pb-3 md:hidden">
    <SearchPlaceholder />
  </div>
</nav>
