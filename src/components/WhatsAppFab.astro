---
import { siteConfig } from '../config/site';
import { siteContent } from '../content/site';
import Icon from './Icon.astro';

const whatsappUrl = `https://wa.me/${siteConfig.whatsappNumber.replace(/\D/g, '')}`;
---

<a
  href={whatsappUrl}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={siteContent.fab.ariaLabel}
  title="WhatsApp"
  class="fixed right-6 bottom-6 z-[998] grid size-14 place-items-center rounded-full bg-brand-whatsapp text-white shadow-[0_4px_16px_rgba(37,211,102,0.5)] transition hover:scale-110 hover:shadow-[0_6px_24px_rgba(37,211,102,0.6)]"
  style="right: calc(1.5rem + env(safe-area-inset-right)); bottom: calc(1.5rem + env(safe-area-inset-bottom));"
>
  <Icon name="whatsapp" class="size-7" />
</a>
