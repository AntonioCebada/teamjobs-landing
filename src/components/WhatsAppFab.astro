---
import { siteConfig } from '../config/site';
import { siteContent } from '../content/site';

const whatsappUrl = `https://wa.me/${siteConfig.whatsappNumber.replace(/\D/g, '')}`;
---

<a
  href={whatsappUrl}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={siteContent.fab.ariaLabel}
  class="fixed z-30 grid size-14 place-items-center rounded-full bg-brand-whatsapp text-white shadow-xl transition-transform hover:scale-105"
  style="right: calc(1rem + env(safe-area-inset-right)); bottom: calc(1rem + env(safe-area-inset-bottom));"
>
  <svg aria-hidden="true" width="25" height="25" viewBox="0 0 24 24">
    <path
      fill="currentColor"
      d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97s-.47-.15-.67.15s-.77.97-.94 1.16s-.35.22-.64.08c-2.58-1.29-4.27-2.3-5.97-5.23c-.45-.78.45-.72 1.29-2.4c.1-.2.05-.37-.03-.52c-.07-.15-.67-1.61-.91-2.21c-.24-.58-.49-.5-.67-.51c-.17-.01-.37-.01-.57-.01s-.52.07-.79.37c-.27.3-1.04 1.02-1.04 2.48s1.07 2.88 1.21 3.07c.15.2 2.1 3.2 5.08 4.49c1.88.81 2.62.88 3.56.74c.57-.09 1.76-.72 2.01-1.41s.25-1.29.17-1.41c-.07-.12-.27-.2-.57-.35M12.05 21.79a9.9 9.9 0 0 1-5.03-1.38l-.36-.21l-3.75.98l1-3.65l-.24-.37a9.86 9.86 0 1 1 8.38 4.63M3.59 22l3.32-.87a11.9 11.9 0 1 0-4.74-4.61L1 22.82z"
    ></path>
  </svg>
</a>
