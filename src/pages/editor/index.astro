---
import { siteContent } from '../../content/site';
import EditorApp from '../../islands/EditorApp';
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title={`${siteContent.editor.title} | ${siteContent.brandName}`}
  description={siteContent.editor.description}
>
  <section class="mx-auto max-w-7xl px-4 py-16 md:px-8">
    <EditorApp client:load />
  </section>
</BaseLayout>
