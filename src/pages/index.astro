---
import About from '../components/About.astro';
import Empresas from '../components/Empresas.astro';
import Hero from '../components/Hero.astro';
import Navbar from '../components/Navbar.astro';
import Solutions from '../components/Solutions.astro';
import WhatsAppFab from '../components/WhatsAppFab.astro';
import { siteConfig } from '../config/site';
import { siteContent } from '../content/site';
import BaseLayout from '../layouts/BaseLayout.astro';

const anchorTargets = siteConfig.navigation
  .map(({ href }) => href)
  .filter(
    (href) => href.startsWith('#') && href.length > 1 && href !== '#inicio',
  );
const implementedAnchors = new Set(['#nosotros', '#servicios', '#empresas']);
---

<BaseLayout>
  <Navbar slot="header" />
  <Hero />
  <About />
  <Solutions />
  <Empresas />
  {
    anchorTargets
      .filter((href) => !implementedAnchors.has(href))
      .map((href) => (
        <div id={href.slice(1)} class="scroll-mt-24" aria-hidden="true" />
      ))
  }
  <WhatsAppFab />
  <p slot="footer" class="page-shell py-6 text-sm text-brand-muted">
    © 2026 {siteContent.brandName}
  </p>
</BaseLayout>
