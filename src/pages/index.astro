---
import { siteContent } from '../content/site';
import '../styles/global.css';

const pageTitle = `${siteContent.brandName} | ${siteContent.foundation.title}`;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={siteContent.foundation.description} />
    <title>{pageTitle}</title>
  </head>
  <body class="min-h-screen bg-slate-950 text-slate-100">
    <a
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-10 focus:bg-white focus:px-4 focus:py-2 focus:text-slate-950"
      href="#main-content"
    >
      Saltar al contenido
    </a>
    <header class="border-b border-slate-800 px-6 py-5" aria-label="Cabecera">
      <p class="m-0 text-sm font-semibold tracking-wide text-sky-300">
        {siteContent.brandName}
      </p>
    </header>
    <main
      id="main-content"
      class="mx-auto flex min-h-[calc(100vh-81px)] max-w-3xl items-center px-6 py-16"
    >
      <section aria-labelledby="foundation-title">
        <p
          class="mb-4 text-sm font-medium uppercase tracking-[0.2em] text-teal-300"
        >
          {siteContent.foundation.status}
        </p>
        <h1
          id="foundation-title"
          class="m-0 text-4xl font-bold tracking-tight sm:text-6xl"
        >
          {siteContent.foundation.title}
        </h1>
        <p class="mt-6 max-w-xl text-lg leading-8 text-slate-300">
          {siteContent.foundation.description}
        </p>
      </section>
    </main>
  </body>
</html>
