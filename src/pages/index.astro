---
import { Image } from 'astro:assets';
import { logo } from '../assets/media';
import { siteContent } from '../content/site';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout>
  <p slot="header" class="page-shell py-5 font-bold text-brand-navy">
    {siteContent.brandName}
  </p>
  <div
    class="page-shell grid min-h-[75vh] items-center gap-10 py-16 md:grid-cols-2"
  >
    <div>
      <p class="eyebrow">{siteContent.foundation.status}</p>
      <h1
        class="mt-5 text-4xl font-bold tracking-tight text-brand-navy md:text-6xl"
      >
        {siteContent.foundation.title}
      </h1>
      <p class="mt-5 max-w-xl text-lg leading-8 text-brand-muted">
        {siteContent.foundation.description}
      </p>
    </div>
    <div class="surface-card mx-auto w-full max-w-sm p-8">
      <Image
        src={logo}
        alt={siteContent.seo.imageAlt}
        width={logo.width}
        height={logo.height}
        loading="eager"
        fetchpriority="high"
      />
    </div>
  </div>
  <p slot="footer" class="page-shell py-6 text-sm text-brand-muted">
    © 2026 {siteContent.brandName}
  </p>
</BaseLayout>
